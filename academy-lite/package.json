{
  "name": "m-pesa-academy-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "M-PESA Academy Lite: a light, phone-first way to learn with a vertical feed, chats, community and profile.",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node ../node_modules/vite/bin/vite.js build",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "preview": "node ../node_modules/vite/bin/vite.js preview",
    "build:deploy": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node ../node_modules/vite/bin/vite.js build --mode deploy"
  }
}
